[TEMPLATE]
# PostgreSQL connection string.
# Production/local-unified: Supabase → Project Settings → Database → Connection string (URI).
# Use the POOLER connection (port 6546) for serverless (Vercel).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6546/postgres"

# Server-side only. Get a key from Google AI Studio.
GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-3.7-flash"  # optional: pin/reorder the model pool (quality-first default)

# Second provider — used only when every Gemini model is unavailable.
OPENROUTER_API_KEY=""

# Supabase Auth (https://supabase.com/dashboard/project/_/settings/api)
# Empty values = auth disabled; the site behaves exactly as before.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Guest data merge token signing key (optional — falls back to GEMINI_API_KEY).
MERGE_TOKEN_SECRET=""
